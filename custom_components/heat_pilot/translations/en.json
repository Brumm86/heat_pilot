{
  "title": "Heat Pilot",
  "config": {
    "step": {
      "user": {
        "title": "Set up Heat Pilot",
        "description": "Heat Pilot is set up once. Add your rooms afterwards from the integration's page (\"Add room\")."
      }
    },
    "abort": {
      "single_instance_allowed": "Heat Pilot can only be set up once."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Notifications",
        "description": "Door warnings and reminders go to the phones of persons at home. Fault alerts go only to the admin phone.",
        "data": {
          "admin_notify": "Admin phone (fault alerts)",
          "ventilation_delay": "Ventilation reminder after (minutes)",
          "unavailable_delay": "Fault alert after a door/window sensor is unreachable for (minutes)",
          "dashboard_path": "Dashboard path opened when tapping a notification",
          "overheat_temp": "Thermostat warning: measured temperature from (°C)",
          "overheat_hold_minutes": "Thermostat warning: for at least (minutes)"
        }
      },
      "persons": {
        "title": "Phone per person",
        "description": "Choose the notification service of each person's phone. Leave empty to not notify a person."
      }
    }
  },
  "config_subentries": {
    "room": {
      "initiate_flow": {
        "user": "Add room",
        "reconfigure": "Reconfigure room"
      },
      "entry_type": "Room",
      "step": {
        "user": {
          "title": "Add room",
          "description": "Define a room with its thermostats, schedule and optional door/window sensors and persons.",
          "data": {
            "name": "Room name",
            "heating_type": "Heating",
            "thermostats": "Thermostats (not needed for \"Other\")",
            "schedule": "Schedule (on = comfort, off = setback; not needed for \"Other\")",
            "door_sensors": "Door sensors",
            "window_sensors": "Window sensors",
            "persons": "Persons (room is shut off when all are away)",
            "notify_persons": "Persons whose phones get door/ventilation messages (none = all)",
            "open_delay_minutes": "Minutes open before shutting off",
            "absence_delay_minutes": "Minutes away before shutting off"
          }
        },
        "reconfigure": {
          "title": "Reconfigure room",
          "description": "Change the room's thermostats, schedule, sensors, persons and delays.",
          "data": {
            "name": "Room name",
            "heating_type": "Heating",
            "thermostats": "Thermostats (not needed for \"Other\")",
            "schedule": "Schedule (on = comfort, off = setback; not needed for \"Other\")",
            "door_sensors": "Door sensors",
            "window_sensors": "Window sensors",
            "persons": "Persons (room is shut off when all are away)",
            "notify_persons": "Persons whose phones get door/ventilation messages (none = all)",
            "open_delay_minutes": "Minutes open before shutting off",
            "absence_delay_minutes": "Minutes away before shutting off"
          }
        }
      },
      "error": {
        "no_thermostat": "Select at least one thermostat.",
        "name_required": "Enter a name.",
        "name_exists": "A room with this name already exists.",
        "schedule_required": "Select a schedule."
      },
      "abort": {
        "reconfigure_successful": "Room updated."
      }
    }
  },
